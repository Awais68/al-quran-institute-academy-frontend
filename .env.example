# Canonical public origin. Drives metadataBase + every <link rel="canonical">.
# Must match CANONICAL_HOST in next.config.js.
NEXT_PUBLIC_SITE_URL=https://alquraninstituteonline.com

# Existing backend (app/constant/constant.js)
NEXT_PUBLIC_API_BASE_URL=https://al-quran-institute-online-backend.onrender.com
NEXT_PUBLIC_API_DEV_URL=http://localhost:4000

# --- Signup lead notifications (app/api/signup/route.ts) -------------------
# Optional but strongly recommended: without these, a signup lead is only
# stored via the backend's /contactForms endpoint, whose insert path currently
# hangs. With them configured, leads still reach you by email.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Comma-separated list of recipients for new enquiries.
LEAD_NOTIFY_EMAIL=
# Must be a domain verified in Resend; falls back to Resend's sandbox sender.
LEAD_FROM_EMAIL=Al-Quran Institute <onboarding@resend.dev>
